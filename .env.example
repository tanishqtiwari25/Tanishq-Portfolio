# Server-only. Copy to .env.local and replace placeholders.
RESEND_API_KEY=re_replace_with_resend_key
CONTACT_RECEIVER_EMAIL=tanishqtiwari265@gmail.com
CONTACT_FROM_EMAIL=Tanishq Portfolio <contact@your-verified-domain.com>
CONTACT_ALLOWED_ORIGIN=http://localhost:3000
# Set to a header overwritten by your trusted host (Vercel: x-vercel-forwarded-for).
CONTACT_TRUSTED_IP_HEADER=

# No Redis required. Rate limits are best-effort per server instance.
# EMAIL_API_KEY is supported as a legacy alias for RESEND_API_KEY.
